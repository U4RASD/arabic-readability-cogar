# Copy this file to .env and fill in your keys.
# The evaluation harness reads these variables when the corresponding
# api_key field in the TOML config is left empty.

OPENAI_API_KEY=
FANAR_API_KEY=
GEMINI_API_KEY=

# Base URL of an OpenAI-compatible endpoint serving Qwen (for example vLLM).
# Leave empty to skip the Qwen rater.
QWEN_BASE_URL=
